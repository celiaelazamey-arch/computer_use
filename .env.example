# CELA.sh reads process environment variables; this file is a reference template.
CELA_OLLAMA_URL=http://127.0.0.1:11434
# Opt-in for exactly the 'ollama' Docker service; keep false outside Docker.
CELA_ALLOW_OLLAMA_CONTAINER_HOST=false
CELA_PLANNER_PROVIDER=ollama
CELA_PLANNER_MODEL=qwen2.5:3b
CELA_EMBEDDING_MODEL=nomic-embed-text
CELA_MEMORY_BACKEND=disabled
CELA_MEMORY_LIMIT=3
CELA_SQLITE_VEC_PATH=cela_memory.db
CELA_QDRANT_URL=http://127.0.0.1:6333
CELA_QDRANT_COLLECTION=agent_memory
CELA_QDRANT_API_KEY=
# Optional on a trusted local API; required by docker-compose.cloud.yml.
# Use a random secret of at least 32 ASCII characters (see docs/cloud-deployment.md).
CELA_API_KEY=
CELA_CONNECT_TIMEOUT=3.05
CELA_READ_TIMEOUT=60
# Compose-only controls (not Settings fields).
CELA_API_PORT=8000
OLLAMA_IMAGE=ollama/ollama:0.40.3
# For production, override PYTHON_IMAGE / OLLAMA_IMAGE with approved digests.
