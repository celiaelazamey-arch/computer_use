# CELA.sh reads process environment variables; this file is a reference template.
CELA_OLLAMA_URL=http://127.0.0.1:11434
CELA_PLANNER_MODEL=qwen2.5:3b
CELA_EMBEDDING_MODEL=nomic-embed-text
CELA_MEMORY_BACKEND=disabled
CELA_MEMORY_LIMIT=3
CELA_QDRANT_URL=http://127.0.0.1:6333
CELA_QDRANT_COLLECTION=agent_memory
CELA_QDRANT_API_KEY=
CELA_CONNECT_TIMEOUT=3.05
CELA_READ_TIMEOUT=60
